# Minecraft (LANに公開したワールドに接続する想定。サーバー運営権限は不要)
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=JevBot
# 空欄推奨: mineflayerがサーバーへの接続時に自動でバージョンを検出する。
# 手動指定する場合は、実際のゲームのバージョンと完全に一致させること
# (不一致だとハンドシェイク中にECONNRESETで切断される)。
MC_VERSION=

# Jev (TypeSafe AI System One) API
# 未設定の場合はモックモード(ランダム/固定応答)で動作します。
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
# 公式ドキュメント(docs.typesafe.ai)確認済み: 推奨モデル名。
JEV_MODEL=jev-latest

# 決定ループの周期(ミリ秒)
DECISION_INTERVAL_MS=250

# Jevの応答を有効とみなす鮮度の上限(ミリ秒)
RESPONSE_FRESHNESS_MS=5000

# 失敗した攻撃/採掘対象を再試行しない期間(ミリ秒、既定35000)
ACTION_COOLDOWN_MS=35000

# prismarine-viewer のポート
VIEWER_PORT=3000
